---
import '@fontsource/spectral-sc/600.css';
import '@fontsource/spectral-sc/700.css';
import '@fontsource-variable/atkinson-hyperlegible-next';
import '../styles/global.css';
// Preloaded so text renders in its final face on the first paint instead of
// swapping (and shifting) a moment after every navigation.
import bodyFont from '@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url';
import titleFont from '@fontsource/spectral-sc/files/spectral-sc-latin-600-normal.woff2?url';
import titleBoldFont from '@fontsource/spectral-sc/files/spectral-sc-latin-700-normal.woff2?url';
import Icon from '../components/Icon.astro';
import SearchPalette from '../components/SearchPalette.astro';
import { ClientRouter } from 'astro:transitions';
import { CATEGORIES, equipment, glossary, masteries, properties, url, weapons } from '../lib/data';

export type Section =
  | 'home'
  | 'glossary'
  | 'weapons'
  | 'masteries'
  | 'properties'
  | 'equipment'
  | 'favourites';

interface Props {
  title: string;
  description?: string;
  section: Section;
  category?: string;
}

const { title, description = 'Fast, searchable D&D 2024 rules glossary, weapons, weapon masteries and equipment, built from the SRD 5.2.1.', section, category } = Astro.props;
const siteName = 'D&D 2024 Reference';
// Content swaps: the old page leaves in 90ms, the new one fades and lifts 6px
// into place in 200ms. The shell around it (header, sidebar) does not move.
const snappy = {
  forwards: {
    old: { name: 'vt-out', duration: '90ms', easing: 'ease-in', fillMode: 'both' },
    new: { name: 'vt-in', duration: '200ms', easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fillMode: 'both' },
  },
  backwards: {
    old: { name: 'vt-out', duration: '90ms', easing: 'ease-in', fillMode: 'both' },
    new: { name: 'vt-in', duration: '200ms', easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fillMode: 'both' },
  },
};
const pageTitle = section === 'home' ? siteName : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const catCounts = new Map<string, number>();
for (const e of glossary) catCounts.set(e.category, (catCounts.get(e.category) ?? 0) + 1);

const path = Astro.url.pathname.replace(/\/?$/, '/');
const current = (s: Section) => (section === s && path === url(s === 'home' ? '' : `${s}/`) ? 'page' : undefined);
// Detail pages highlight their parent section without claiming aria-current.
const within = (s: Section) => (section === s && !current(s) ? '' : undefined);
// The bottom bar's Weapons tab covers the weapon rules pages too; it only claims
// aria-current on the weapons index itself.
const armsActive = ['masteries', 'properties'].includes(section) || within('weapons') !== undefined ? '' : undefined;
---

<!doctype html>
<html lang="en-GB" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0a0b" />
    <link rel="icon" href={url('icon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('icon-192.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={titleFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={titleBoldFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      (() => {
        // Theme and sidebar state live on <html>. The router copies the next
        // page's <html> attributes over these on every swap, so they are
        // re-applied after each swap as well as before the first paint.
        const root = document.documentElement;
        const apply = () => {
          let pref = null;
          let sidebar = null;
          try { pref = localStorage.getItem('dnd-ref:theme'); sidebar = localStorage.getItem('dnd-ref:sidebar'); } catch {}
          const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          if (pref === 'light' || pref === 'dark') root.dataset.theme = pref;
          root.dataset.resolvedTheme = pref === 'light' || pref === 'dark' ? pref : system;
          if (sidebar === 'collapsed') root.dataset.sidebar = 'collapsed';
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
        // The sidebar is swapped with the page; keep its scroll position.
        document.addEventListener('astro:before-swap', () => {
          try { sessionStorage.setItem('dnd-ref:sidebar-scroll', String(document.getElementById('sidebar')?.scrollTop ?? 0)); } catch {}
        });
        document.addEventListener('astro:after-swap', () => {
          const nav = document.getElementById('sidebar');
          try { if (nav) nav.scrollTop = Number(sessionStorage.getItem('dnd-ref:sidebar-scroll')) || 0; } catch {}
        });
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body data-base={url()}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="app-header" transition:persist="app-header" transition:animate="none">
      <button class="icon-btn sidebar-toggle" type="button" data-sidebar-toggle aria-controls="sidebar" aria-expanded="true" aria-label="Collapse sidebar">
        <Icon name="panelLeft" />
      </button>
      <a class="brand" href={url()} aria-label={`${siteName} home`}>
        <span class="brand-mark"><Icon name="d20" size={22} /></span>
        <span class="brand-text">D&amp;D <span class="brand-sub">2024</span> Reference</span>
      </a>
      <div class="header-search">
        <button class="search-trigger" type="button" data-open-search aria-haspopup="dialog">
          <Icon name="search" size={18} />
          <span>Search rules, weapons, gear…</span>
          <kbd data-shortcut-hint>Ctrl K</kbd>
        </button>
      </div>
      <div class="header-actions">
        <button class="icon-btn header-search-icon" type="button" data-open-search aria-haspopup="dialog" aria-label="Search">
          <Icon name="search" />
        </button>
        <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">
          <Icon name="sun" class="icon-sun" />
          <Icon name="moon" class="icon-moon" />
        </button>
      </div>
    </header>

    <div class="shell">
      <nav class="sidebar" id="sidebar" aria-label="Sections">
        <div class="nav-group">
          <ul class="nav-list">
            <li><a class="nav-link" href={url()} aria-current={current('home')}><Icon name="home" size={18} /><span class="nav-label">Home</span></a></li>
            <li><a class="nav-link" href={url('favourites/')} aria-current={current('favourites')}><Icon name="star" size={18} /><span class="nav-label">Favourites</span></a></li>
          </ul>
        </div>
        <div class="nav-group">
          <p class="nav-heading">Rules Glossary</p>
          <ul class="nav-list">
            <li>
              <a class="nav-link" href={url('glossary/')} aria-current={current('glossary')} data-nav-all>
                <Icon name="book" size={18} /><span class="nav-label">All rules</span><span class="nav-count">{glossary.length}</span>
              </a>
            </li>
            {
              CATEGORIES.filter((c) => catCounts.has(c.name)).map((c) => (
                <li>
                  <a class="nav-link" href={url(`glossary/?category=${c.slug}`)} data-nav-category={c.slug} data-active={category === c.name ? '' : undefined}>
                    <Icon name={c.icon} size={18} />
                    <span class="nav-label">{c.name}</span>
                    <span class="nav-count">{catCounts.get(c.name)}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="nav-group">
          <p class="nav-heading">Equipment</p>
          <ul class="nav-list">
            <li><a class="nav-link" href={url('weapons/')} aria-current={current('weapons')} data-active={within('weapons')}><Icon name="swords" size={18} /><span class="nav-label">Weapons</span><span class="nav-count">{weapons.length}</span></a></li>
            <li><a class="nav-link" href={url('masteries/')} aria-current={current('masteries')} data-active={within('masteries')}><Icon name="sparkles" size={18} /><span class="nav-label">Weapon Masteries</span><span class="nav-count">{masteries.length}</span></a></li>
            <li><a class="nav-link" href={url('properties/')} aria-current={current('properties')} data-active={within('properties')}><Icon name="tag" size={18} /><span class="nav-label">Weapon Properties</span><span class="nav-count">{properties.length}</span></a></li>
            <li><a class="nav-link" href={url('equipment/')} aria-current={current('equipment')} data-active={within('equipment')}><Icon name="backpack" size={18} /><span class="nav-label">Gear &amp; Armor</span><span class="nav-count">{equipment.length}</span></a></li>
          </ul>
        </div>
      </nav>
      <script is:inline>
        // Keep the sidebar where the reader left it across page loads.
        try {
          const nav = document.getElementById('sidebar');
          nav.scrollTop = Number(sessionStorage.getItem('dnd-ref:sidebar-scroll')) || 0;
          addEventListener('pagehide', () => sessionStorage.setItem('dnd-ref:sidebar-scroll', String(nav.scrollTop)), { once: true });
        } catch {}
      </script>

      <main class="main" id="main" tabindex="-1" transition:name="main" transition:animate={snappy}>
        <div class="main-inner">
          <slot />
          <footer class="app-footer">
            <p>
              This work includes material from the System Reference Document 5.2.1 (“SRD 5.2.1”) by Wizards of the Coast LLC, available at{' '}
              <a href="https://www.dndbeyond.com/srd" rel="noopener">dndbeyond.com/srd</a>. The SRD 5.2.1 is licensed under the{' '}
              <a href="https://creativecommons.org/licenses/by/4.0/legalcode" rel="noopener license">Creative Commons Attribution 4.0 International License</a>.
            </p>
            <p>Unofficial fan reference. Not affiliated with or endorsed by Wizards of the Coast.</p>
          </footer>
        </div>
      </main>
    </div>

    <nav class="bottom-nav" aria-label="Primary">
      <a href={url()} aria-current={current('home')}><Icon name="home" size={22} />Home</a>
      <a href={url('glossary/')} aria-current={current('glossary')} data-active={within('glossary')}><Icon name="book" size={22} />Rules</a>
      <button type="button" data-open-search aria-haspopup="dialog"><Icon name="search" size={22} />Search</button>
      <a href={url('weapons/')} aria-current={current('weapons')} data-active={armsActive}><Icon name="swords" size={22} />Weapons</a>
      <a href={url('favourites/')} aria-current={current('favourites')}><Icon name="star" size={22} />Saved</a>
    </nav>

    <SearchPalette />

    <div class="term-tip" id="term-tip" popover="manual" role="tooltip" transition:persist="term-tip"></div>

    <script>
      import { initShell } from '../scripts/shell';
      initShell();
    </script>
  </body>
</html>
