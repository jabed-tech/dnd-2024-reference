---
import type { GetStaticPaths } from 'astro';
import AppShell from '../../layouts/AppShell.astro';
import FavButton from '../../components/FavButton.astro';
import EntryLayout from '../../components/EntryLayout.astro';
import Icon from '../../components/Icon.astro';
import AsideList from '../../components/AsideList.astro';
import RecentPanel from '../../components/RecentPanel.astro';
import { categoryMeta, glossary, glossaryBySlug, glossaryUrl, linkTerms, url, withLeadIns, wrapTables, type GlossaryEntry } from '../../lib/data';

export const getStaticPaths = (() =>
  glossary.map((entry, i) => ({
    params: { slug: entry.slug },
    props: { entry, prev: glossary[i - 1], next: glossary[i + 1] },
  }))) satisfies GetStaticPaths;

interface Props {
  entry: GlossaryEntry;
  prev?: GlossaryEntry;
  next?: GlossaryEntry;
}

const { entry, prev, next } = Astro.props;
const id = `glossary/${entry.slug}`;
const cat = categoryMeta(entry.category);
const { html: body, items: leadIns } = withLeadIns(wrapTables(linkTerms(entry.body, id)));
const seeAlso = entry.seeAlso.map((s) => glossaryBySlug.get(s)).filter((e): e is GlossaryEntry => !!e);
// Tag families (e.g. every [Condition]) make a useful "related" list.
const family = entry.tag
  ? glossary.filter((e) => e.tag === entry.tag && e.slug !== entry.slug && !entry.seeAlso.includes(e.slug))
  : [];
const tagEntry = entry.tag ? glossary.find((e) => e.title === entry.tag && !e.tag) : undefined;
// Always give the side column something to show, even for entries with no links.
const MORE_LIMIT = 8;
const ASIDE_LIMIT = 8;
const shown = new Set([entry.slug, ...entry.seeAlso, ...family.map((e) => e.slug)]);
const inCategory = glossary.filter((e) => e.category === entry.category);
const moreInCategory = inCategory.filter((e) => !shown.has(e.slug)).slice(0, MORE_LIMIT);
---

<AppShell title={entry.title} section="glossary" category={entry.category} description={entry.summary}>
  <EntryLayout backFallback={url('glossary/')} backLabel="Rules Glossary">
    <article class="entry" data-doc-id={id}>
      <div>
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href={url('glossary/')}>Rules Glossary</a></li>
            <li><a href={url(`glossary/?category=${cat.slug}`)}>{entry.category}</a></li>
            <li aria-current="page">{entry.title}</li>
          </ol>
        </nav>
      </div>

      <div class="block">
        <header class="entry-head">
          <div class="entry-title-row">
            <h1>{entry.title}</h1>
            <FavButton id={id} name={entry.title} size={24} />
          </div>
          <p class="entry-sub">
            {
              entry.tag ? (
                tagEntry ? <a href={glossaryUrl(tagEntry.slug)}>{entry.tag}</a> : <span>{entry.tag}</span>
              ) : (
                <a href={url(`glossary/?category=${cat.slug}`)}>{entry.category}</a>
              )
            }
          </p>
        </header>
        <span class="taper" aria-hidden="true"></span>
        {
          (entry.tag || leadIns.length > 0) && (
            <>
              <dl class="stat-line">
                {entry.tag && (
                  <div><dt>Category</dt><dd><a href={url(`glossary/?category=${cat.slug}`)}>{entry.category}</a></dd></div>
                )}
                {leadIns.length > 0 && (
                  <div class="stat-jump">
                    <dt>In this rule</dt>
                    <dd>
                      {leadIns.map((l, i) => (
                        <>
                          {i > 0 && <span aria-hidden="true"> · </span>}
                          <a href={`#${l.id}`}>{l.text}</a>
                        </>
                      ))}
                    </dd>
                  </div>
                )}
              </dl>
              <span class="taper" aria-hidden="true"></span>
            </>
          )
        }
        <div class="prose" set:html={body} />
        {
          entry.srdRefs && entry.srdRefs.length > 0 && (
            <p class="entry-body-note">See also in the SRD: {entry.srdRefs.join('; ')}.</p>
          )
        }
      </div>

      <nav class="pager" aria-label="Previous and next rule">
        {prev && <a class="prev" href={glossaryUrl(prev.slug)} rel="prev"><small><Icon name="chevronLeft" size={14} />Previous</small>{prev.title}</a>}
        {next && <a class="next" href={glossaryUrl(next.slug)} rel="next"><small>Next<Icon name="chevronRight" size={14} /></small>{next.title}</a>}
      </nav>
    </article>

    <Fragment slot="aside">
      {
        seeAlso.length > 0 && (
          <section class="panel panel-accent" aria-labelledby="see-also">
            <h2 class="panel-title" id="see-also"><Icon name="book" size={16} />See also</h2>
            <AsideList items={seeAlso.map((e) => ({ name: e.title, href: glossaryUrl(e.slug), meta: e.tag ?? e.category, term: `glossary/${e.slug}` }))} />
          </section>
        )
      }

      <RecentPanel exclude={id} />

      {
        family.length > 0 && (
          <section class="panel" aria-labelledby="family">
            <h2 class="panel-title" id="family"><Icon name={cat.icon} size={16} />Other {entry.tag} rules</h2>
            <AsideList items={family.slice(0, ASIDE_LIMIT).map((e) => ({ name: e.title, href: glossaryUrl(e.slug), term: `glossary/${e.slug}` }))} />
            {family.length > ASIDE_LIMIT && (
              <a class="aside-more" href={url(`glossary/?category=${cat.slug}`)}>All {glossary.filter((e) => e.tag === entry.tag).length} {entry.tag} rules<Icon name="chevronRight" size={14} /></a>
            )}
          </section>
        )
      }

      {
        moreInCategory.length > 0 && (
          <section class="panel" aria-labelledby="more-category">
            <h2 class="panel-title" id="more-category"><Icon name={cat.icon} size={16} />More in {entry.category}</h2>
            <AsideList items={moreInCategory.map((e) => ({ name: e.title, href: glossaryUrl(e.slug), meta: e.tag, term: `glossary/${e.slug}` }))} />
            <a class="aside-more" href={url(`glossary/?category=${cat.slug}`)}>All in {entry.category} ({inCategory.length})<Icon name="chevronRight" size={14} /></a>
          </section>
        )
      }
    </Fragment>
  </EntryLayout>
</AppShell>
