---
import AppShell from '../layouts/AppShell.astro';
import Icon from '../components/Icon.astro';
import { CATEGORIES, equipment, glossary, glossaryBySlug, glossaryUrl, masteries, masteryUrl, properties, url, weapons } from '../lib/data';

const counts = new Map<string, number>();
for (const e of glossary) counts.set(e.category, (counts.get(e.category) ?? 0) + 1);

const quick = [
  { title: 'Weapons', count: weapons.length, href: url('weapons/') },
  { title: 'Weapon Masteries', count: masteries.length, href: url('masteries/') },
  { title: 'Weapon Properties', count: properties.length, href: url('properties/') },
  { title: 'Gear & Armor', count: equipment.length, href: url('equipment/') },
];

// Handy at-the-table lookups; only include entries that exist in the data.
const combatStaples = ['attack-action', 'dash-action', 'disengage-action', 'dodge-action', 'help-action', 'hide-action', 'ready-action', 'opportunity-attack', 'grappled-condition', 'prone-condition']
  .map((s) => glossaryBySlug.get(s))
  .filter((e) => !!e);
const conditions = glossary.filter((e) => e.tag === 'Condition');
---

<AppShell title="Home" section="home">
  <section class="home-head">
    <h1>Find any rule in seconds.</h1>
    <span class="taper" aria-hidden="true"></span>
    <button class="search-trigger" type="button" data-open-search aria-haspopup="dialog">
      <Icon name="search" size={20} />
      <span>Search “grappled”, “longsword”, “topple”…</span>
      <kbd data-shortcut-hint>Ctrl K</kbd>
    </button>
    <p>The 2024 Rules Glossary, weapons, masteries and equipment from the SRD 5.2.1. Works offline once it has loaded.</p>
  </section>

  <section class="home-contents" aria-labelledby="contents-h">
    <h2 id="contents-h" class="visually-hidden">Contents</h2>
    <div class="contents">
      <div class="panel">
        <h3 class="panel-title"><Icon name="book" size={18} />Rules Glossary</h3>
        <ul class="contents-list">
          <li><a href={url('glossary/')}>All rules<span class="count">{glossary.length}</span></a></li>
          {
            CATEGORIES.filter((c) => counts.has(c.name)).map((c) => (
              <li><a href={url(`glossary/?category=${c.slug}`)}>{c.name}<span class="count">{counts.get(c.name)}</span></a></li>
            ))
          }
        </ul>
      </div>
      <div class="panel">
        <h3 class="panel-title"><Icon name="swords" size={18} />Equipment</h3>
        <ul class="contents-list">
          {quick.map((q) => <li><a href={q.href}>{q.title}<span class="count">{q.count}</span></a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" data-home-saved hidden aria-labelledby="saved-h">
    <div class="section-head">
      <h2 id="saved-h">Saved</h2>
      <a href={url('favourites/')}>All favourites<Icon name="chevronRight" size={16} /></a>
    </div>
    <div class="chips" data-saved-list></div>
  </section>

  <section class="section" data-home-recent hidden aria-labelledby="recent-h">
    <div class="section-head">
      <h2 id="recent-h">Recently viewed</h2>
    </div>
    <div class="chips" data-recent-list></div>
  </section>

  {
    conditions.length > 0 && (
      <section class="section" aria-labelledby="conditions-h">
        <div class="section-head">
          <h2 id="conditions-h">Conditions</h2>
          <a href={url('glossary/?category=conditions')}>View all<Icon name="chevronRight" size={16} /></a>
        </div>
        <div class="chips">
          {conditions.map((e) => (
            <a class="chip" href={glossaryUrl(e.slug)} data-term={`glossary/${e.slug}`}>{e.title}</a>
          ))}
        </div>
      </section>
    )
  }

  {
    combatStaples.length > 0 && (
      <section class="section" aria-labelledby="combat-h">
        <div class="section-head">
          <h2 id="combat-h">In combat</h2>
          <a href={url('glossary/?category=actions')}>All actions<Icon name="chevronRight" size={16} /></a>
        </div>
        <div class="chips">
          {combatStaples.map((e) => (
            <a class="chip" href={glossaryUrl(e!.slug)}>{e!.title}</a>
          ))}
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="masteries-h">
    <div class="section-head">
      <h2 id="masteries-h">Weapon Masteries</h2>
      <a href={url('masteries/')}>Full rules<Icon name="chevronRight" size={16} /></a>
    </div>
    <dl class="mastery-list">
      {
        masteries.map((m) => (
          <div>
            <dt><a href={masteryUrl(m.slug)}>{m.name}</a></dt>
            <dd>{m.summary}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</AppShell>

<script>
  import { getFavourites, getRecent, loadIndex } from '../scripts/store';
  import { escapeHtml } from '../scripts/search';
  import { onPage } from '../scripts/page';

  const renderChips = (el: HTMLElement, ids: string[], byId: Map<string, { url: string; title: string }>) => {
    el.innerHTML = ids
      .map((id) => byId.get(id))
      .filter((d) => !!d)
      .map((d) => `<a class="chip" href="${d!.url}">${escapeHtml(d!.title)}</a>`)
      .join('');
    return el.children.length > 0;
  };

  onPage(() => {
    const saved = document.querySelector<HTMLElement>('[data-home-saved]');
    const rec = document.querySelector<HTMLElement>('[data-home-recent]');
    if (!saved || !rec) return;
    const favs = getFavourites();
    const recent = getRecent();
    if (!favs.length && !recent.length) return;
    loadIndex()
      .then((docs) => {
        const byId = new Map(docs.map((d) => [d.id, d]));
        saved.hidden = !renderChips(saved.querySelector('[data-saved-list]')!, favs.slice(0, 12), byId);
        rec.hidden = !renderChips(rec.querySelector('[data-recent-list]')!, recent, byId);
      })
      .catch(() => {});
  });
</script>
