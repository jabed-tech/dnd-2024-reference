---
// One entry in a dense index list: title, badges and summary, with the whole row
// as the link target and the favourite star above it.
import FavButton from './FavButton.astro';

interface Props {
  id: string;
  title: string;
  href: string;
  summary: string;
  badges?: { text: string; tone?: 'red' | 'outline' }[];
  attrs?: Record<string, string>;
}

const { id, title, href, summary, badges = [], attrs = {} } = Astro.props;
---

<li class="row" {...attrs}>
  <div class="row-main">
    <h3 class="row-title">
      <a class="row-link" href={href}>{title}</a>
      {badges.map((b) => <span class:list={['badge', b.tone && `badge-${b.tone}`]}>{b.text}</span>)}
    </h3>
    <p class="row-summary">{summary}</p>
  </div>
  <FavButton id={id} name={title} size={20} />
</li>
